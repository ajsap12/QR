{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QEC Evidence Object",
  "type": "object",
  "required": ["evidence_id", "paper_id", "source_url", "locator", "excerpt", "review_status"],
  "properties": {
    "evidence_id": {"type": "string"},
    "paper_id": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "locator": {
      "type": "object",
      "properties": {
        "page": {"type": ["integer", "null"]},
        "section": {"type": ["string", "null"]},
        "figure": {"type": ["string", "null"]},
        "table": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "excerpt": {"type": "string"},
    "evidence_type": {
      "type": "string",
      "enum": ["claim", "equation", "algorithm", "benchmark", "limitation", "assumption", "result"]
    },
    "review_status": {
      "type": "string",
      "enum": ["unreviewed", "approved", "rejected", "needs_context"]
    },
    "reviewer": {"type": ["string", "null"]},
    "review_notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}