{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QEC Claim Object",
  "type": "object",
  "required": ["claim_id", "paper_id", "claim_text", "evidence_ids", "review_status"],
  "properties": {
    "claim_id": {"type": "string"},
    "paper_id": {"type": "string"},
    "claim_text": {"type": "string"},
    "claim_type": {
      "type": "string",
      "enum": ["performance", "complexity", "threshold", "scaling", "architecture", "limitation", "comparison", "theory"]
    },
    "code_family": {"type": ["string", "null"]},
    "decoder": {"type": ["string", "null"]},
    "noise_model": {"type": ["string", "null"]},
    "metric": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_status": {
      "type": "string",
      "enum": ["unreviewed", "approved", "rejected", "needs_context"]
    },
    "contradicts_claim_ids": {"type": "array", "items": {"type": "string"}},
    "qualifiers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}