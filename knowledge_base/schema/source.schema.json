{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajsap12/QR/knowledge_base/schema/source.schema.json",
  "title": "QEC Frontier Source",
  "type": "object",
  "required": [
    "id",
    "title",
    "source_type",
    "publication_date",
    "evidence_tags",
    "categories",
    "main_contribution",
    "limitations",
    "relevance_to_qr",
    "extraction_confidence"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "title": {"type": "string", "minLength": 3},
    "authors_or_org": {"type": "array", "items": {"type": "string"}},
    "source_type": {
      "type": "string",
      "enum": ["paper", "preprint", "conference", "repository", "patent", "industry_report", "technical_blog", "dataset", "standard"]
    },
    "publication_date": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"},
    "venue": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"]},
    "doi_or_identifier": {"type": ["string", "null"]},
    "publication_status": {"type": ["string", "null"]},
    "evidence_tags": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["FACT", "PUB", "PAT", "REPO", "ENG", "MARKET", "HYP", "SPEC"]}
    },
    "categories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decoder_families": {"type": "array", "items": {"type": "string"}},
    "code_families": {"type": "array", "items": {"type": "string"}},
    "noise_models": {"type": "array", "items": {"type": "string"}},
    "hardware_targets": {"type": "array", "items": {"type": "string"}},
    "main_contribution": {"type": "string", "minLength": 10},
    "reported_performance": {"type": ["string", "null"]},
    "latency_claims": {"type": ["string", "null"]},
    "hardware_assumptions": {"type": ["string", "null"]},
    "limitations": {"type": "string", "minLength": 5},
    "code_availability": {"type": ["string", "null"]},
    "repository_url": {"type": ["string", "null"]},
    "patent_or_ownership_notes": {"type": ["string", "null"]},
    "nearest_prior_art": {"type": "array", "items": {"type": "string"}},
    "relevance_to_qr": {"type": "string", "minLength": 5},
    "commercial_relevance": {"type": ["string", "null"]},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "research_momentum_score": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
    "implementation_maturity_score": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
    "commercial_signal_score": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
    "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_status": {"type": "string", "enum": ["seed", "screened", "verified", "rejected"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
